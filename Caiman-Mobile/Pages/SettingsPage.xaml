<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Caiman_Panel.SettingsPage"
             Title="Settings"
             BackgroundColor="#0A0F0A">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Seção: Conta -->
            <Label Text="CONTA" FontSize="14" FontAttributes="Bold" TextColor="#1FFF00" />
            <Frame Style="{StaticResource PanelFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Usuário" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Username}" TextColor="#1FFF00" />
                    </Grid>
                    <Label Text="{Binding AccountStatus}" FontSize="11" TextColor="#E0E0E0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Seção: Configurações Gerais -->
            <Label Text="GERAL" FontSize="14" FontAttributes="Bold" TextColor="#1FFF00" />
            <Frame Style="{StaticResource PanelFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <!-- Tema -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Tema Escuro" FontSize="12" TextColor="#FFFFFF" />
                        <Switch Grid.Column="1" IsToggled="True" OnColor="#1FFF00" />
                    </Grid>

                    <!-- Notificações -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Notificações" FontSize="12" TextColor="#FFFFFF" />
                        <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" OnColor="#1FFF00" />
                    </Grid>

                    <!-- Auto-login -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Auto-login" FontSize="12" TextColor="#FFFFFF" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutoLoginEnabled}" OnColor="#1FFF00" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Seção: Performance -->
            <Label Text="PERFORMANCE" FontSize="14" FontAttributes="Bold" TextColor="#1FFF00" />
            <Frame Style="{StaticResource PanelFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <!-- CPU Usage -->
                    <Label Text="Uso de CPU" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" />
                    <ProgressBar Progress="{Binding CPUUsage}" ProgressColor="#1FFF00" />
                    <Label Text="{Binding CPUUsage, StringFormat='{0:P0}'}" FontSize="10" TextColor="#1FFF00" />

                    <!-- Memory Usage -->
                    <Label Text="Uso de Memória" FontSize="12" TextColor="#FFFFFF" FontAttributes="Bold" Margin="0,8,0,0" />
                    <ProgressBar Progress="{Binding MemoryUsage}" ProgressColor="#1FFF00" />
                    <Label Text="{Binding MemoryUsage, StringFormat='{0:P0}'}" FontSize="10" TextColor="#1FFF00" />
                </VerticalStackLayout>
            </Frame>

            <!-- Seção: Informações -->
            <Label Text="INFORMAÇÕES" FontSize="14" FontAttributes="Bold" TextColor="#1FFF00" />
            <Frame Style="{StaticResource PanelFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="Versão:" FontSize="11" TextColor="#E0E0E0" />
                        <Label Grid.Column="1" Text="1.0.0" TextColor="#1FFF00" HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="Plataforma:" FontSize="11" TextColor="#E0E0E0" />
                        <Label Grid.Column="1" x:Name="PlatformLabel" TextColor="#1FFF00" HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="Dispositivo:" FontSize="11" TextColor="#E0E0E0" />
                        <Label Grid.Column="1" x:Name="DeviceLabel" TextColor="#1FFF00" HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="Última Atualização:" FontSize="11" TextColor="#E0E0E0" />
                        <Label Grid.Column="1" Text="{Binding LastUpdateTime}" TextColor="#1FFF00" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Botões de Ação -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="🔄 VERIFICAR ATUALIZAÇÕES"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CheckUpdatesCommand}" />

                <Button Text="🗑️ LIMPAR CACHE"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearCacheCommand}" />

                <Button Text="📋 VER LOGS"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ViewLogsCommand}" />

                <Button Text="🚪 DESCONECTAR"
                        Style="{StaticResource SecondaryButtonStyle}"
                        BackgroundColor="#8B0000"
                        TextColor="#FFFFFF"
                        Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
