<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Caiman_Panel.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta de Cores CAIMAN - Verde Neon -->
            <Color x:Key="PrimaryGreen">#1FFF00</Color>
            <Color x:Key="BrightGreen">#00FF00</Color>
            <Color x:Key="DarkBackground">#0A0F0A</Color>
            <Color x:Key="SecondaryBackground">#1A1A1A</Color>
            <Color x:Key="PanelBackground">#0D1B0D</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#E0E0E0</Color>
            <Color x:Key="AccentDark">#0D540D</Color>

            <!-- Estilos de Botão -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,10" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBackground}" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <!-- Estilos de Label -->
            <Style x:Key="TitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="SubtitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <!-- Estilos de Entry -->
            <Style x:Key="StandardEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource PanelBackground}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <!-- FrameStyle para Containers -->
            <Style x:Key="PanelFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBackground}" />
                <Setter Property="BorderColor" Value="{StaticResource PrimaryGreen}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
